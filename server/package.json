{
  "name": "media-server-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format esm --platform node --out-dir dist --clean && tsc --project tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@u4/adbkit": "^5.1.7",
    "express": "^5.2.1",
    "video-name-parser": "^1.4.7",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
